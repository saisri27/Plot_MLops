# =============================================================================
# Plot App — .gitignore
# =============================================================================

# !! CREDENTIALS — NEVER COMMIT THESE !!
.env
*.env
!.env.example
service-account*.json
*-key.json
credentials.json

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.cache/

# MLflow local artifacts
mlruns/
mlartifacts/

# Trained models (joblib artifacts written by notebooks/train_ranker.py)
models/

# Generated training datasets (rebuild from build_training_data.py)
training_data/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Testing
.pytest_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
package.json
package-lock.json

# Archive files — never commit zips/tarballs (design-system exports,
# raw API dumps, etc. belong outside git)
*.zip
*.tar
*.tar.gz
*.tgz

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Docker
*.log

# GCP
.gcloud/

# Claude Code session state
.claude/

# Session-specific HTML scratchpads
today_progress.html
